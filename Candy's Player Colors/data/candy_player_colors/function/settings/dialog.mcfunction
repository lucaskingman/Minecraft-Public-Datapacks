ngs/apply {friendlyFire:$(friendlyFire),seeFriendlyInvisibles:$(seeFriendlyInvisibles),nametagVisibility:$(nametagVisibility),deathMessageVisibility:$(deathMessageVisibility),collisionRule:$(collisionRule)}"}}]}